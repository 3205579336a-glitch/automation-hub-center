{
  "name": "sap-automation-toolbox",
  "version": "0.2.5",
  "description": "A secure Windows desktop foundation for SAP WebGUI automation.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "SAP Automation Toolbox",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "smoke": "npm run build && node scripts/smoke-test.mjs",
    "smoke:task-controls": "npm run build && node scripts/task-controls-smoke-test.mjs",
    "test:productivity-recovery": "node --test scripts/test-productivity-recovery.mjs && py -3 scripts/test-rfq-launch-gate.py",
    "test:artifacts": "node --test scripts/test-generated-artifacts.mjs && py -3 scripts/test-hub-artifacts.py",
    "smoke:safe-recovery": "npm run build && node scripts/safe-recovery-smoke-test.mjs",
    "test:apqp": "node --test scripts/test-apqp-template-header.mjs scripts/test-apqp-saved-preview.mjs && py -3 scripts/test-apqp-plan-closure.py",
    "test:apqp-dates": "py -3 scripts/test-apqp-date-discovery.py && py -3 scripts/test-apqp-date-api.py && py -3 scripts/test-apqp-date-update.py && node --test scripts/test-apqp-date-service.mjs scripts/test-apqp-date-view.mjs scripts/test-apqp-date-cache.mjs",
    "test:guided": "node --test scripts/test-guided-automation.mjs && py -3 scripts/test-hub-user-interaction.py",
    "test:sap-startup": "py -3 scripts/test-sap-gui-connection.py && node --test scripts/test-me12-startup.mjs",
    "test:intelligence": "node --test scripts/test-local-intelligence.mjs",
    "test:me52n": "py -3 scripts/test-me52n-project-ref.py",
    "test:me01": "py -3 scripts/test-me01-source-list.py && py -3 scripts/test-me01-source-table.py && node --test scripts/test-me01-preview.mjs",
    "test:rfq": "py -3 scripts/test-rfq-integration.py && py -3 scripts/test-rfq-buyer-save.py",
    "test:rfq-runtime": "py -3 scripts/test-rfq-runtime-improvements.py",
    "test:history-deletion": "node --test scripts/test-history-deletion.mjs",
    "test:rfq-runner": "node --test scripts/test-rfq-runner.mjs",
    "test:rfq-writeback": "py -3 scripts/test-rfq-source-writeback.py && node --test scripts/test-rfq-runner.mjs",
    "test:rfq-fields": "py -3 scripts/test-rfq-qty-cost-breakdown.py",
    "test:rfq-recovery": "py -3 scripts/test-rfq-recovery.py",
    "test:rfq-material-reset": "py -3 scripts/test-rfq-material-reset.py",
    "smoke:rfq": "npm run build && node scripts/rfq-smoke-test.mjs",
    "smoke:rfq-runtime": "npm run build && node scripts/rfq-runtime-smoke-test.mjs",
    "smoke:rfq-stop": "npm run build && node scripts/rfq-stop-smoke-test.mjs",
    "smoke:intelligence": "npm run build && node scripts/intelligence-smoke-test.mjs",
    "smoke:apqp": "npm run build && node scripts/apqp-smoke-test.mjs",
    "smoke:apqp-dates": "npm run build && node scripts/apqp-dates-smoke-test.mjs",
    "smoke:apqp-session": "npm run build && node scripts/apqp-session-smoke-test.mjs",
    "build:engine": "powershell -ExecutionPolicy Bypass -File scripts/build-automation-engine.ps1",
    "package:win": "npm run build:engine && npm run build && electron-builder --win nsis",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.sapautomation.toolbox",
    "productName": "SAP Automation Toolbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "resources/rpa-engine/automation-engine",
        "to": "rpa-engine/automation-engine"
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
